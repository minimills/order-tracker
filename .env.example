# Copy this file to .env.local and fill in the values.
# Find them in Supabase: Project Settings -> API.
# Only the public "anon" key goes here. NEVER put the service_role key,
# AI keys or email passwords in any VITE_ variable – they would end up in the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only for the one-off sheet import (npm run import-sheet). NOT prefixed with VITE_,
# so it never reaches the website. Find it in Supabase: Project Settings -> API Keys
# -> service_role (secret). Keep it only in .env.local; delete it after importing.
# SUPABASE_SERVICE_ROLE_KEY=
